{
  "version": 1,
  "project": "flowbase-vertical",
  "max_loop": 5,
  "gates": [
    {
      "id": "typecheck",
      "run": "npm run typecheck",
      "stage": "dev"
    },
    {
      "id": "test",
      "run": "npm test",
      "stage": "dev",
      "timeout_s": 600
    },
    {
      "id": "drift",
      "run": "npx depcruise src --validate",
      "stage": "dev",
      "enabled": false,
      "_note": "설계이탈 게이트. .dependency-cruiser.cjs 설정 후 enabled:true"
    },
    {
      "id": "build",
      "run": "npm run build",
      "stage": "ship",
      "timeout_s": 600,
      "_note": "CI(ci.yml 마지막 스텝)가 매 푸시마다 돌린다. dev에서는 typecheck가 tsc --noEmit을 이미 본다 — 매 응답 34초를 두 번 낼 이유가 없다"
    },
    {
      "id": "deploy",
      "run": "npx vercel deploy --prod --yes",
      "stage": "ship",
      "timeout_s": 900
    },
    {
      "id": "smoke",
      "run": "curl -sfL --max-time 30 https://CHANGE-ME.example.com | grep -qi '<title>'",
      "stage": "ship",
      "_note": "배포된 실제 URL로 교체. grep 대상은 반드시 떠야 하는 문자열."
    }
  ]
}
