{
  "name": "flowbase-vertical",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "FlowBase 손익 — 셀러 정산·손익 앱 (로컬퍼스트)",
  "scripts": {
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "convert": "tsx tools/convert/convert.ts",
    "convert:gate": "tsx tools/convert/gate.ts",
    "state": "tsx tools/harness/state.ts",
  "gates:selftest": "tsx tools/harness/selftest.ts",
  "facts": "tsx tools/harness/facts.ts",
    "harness": "tsx tools/harness/build-manifest.ts",
    "perf": "tsx tools/harness/perf-gate.ts",
    "e2e": "tsx tools/harness/e2e-gate.ts",
    "dev": "vite",
    "app": "tauri dev",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "wiring": "tsx tools/harness/wiring.ts",
    "render:wizard": "tsx tools/harness/render-wizard.ts",
    "demo-db": "tsx tools/harness/demo-db.ts",
    "prebuild": "npm run demo-db",
    "single": "npm run demo-db && vite build --config vite.single.config.ts && tsx tools/harness/inline-build.ts"
  },
  "dependencies": {
    "@tauri-apps/api": "^2.11.1",
    "@types/sql.js": "^1.4.11",
    "fflate": "^0.8.3",
    "lucide-react": "^1.31.0",
    "pretendard": "^1.3.9",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "sql.js": "^1.14.2",
    "xlsx": "file:vendor/xlsx-0.20.3.tgz"
  },
  "devDependencies": {
    "@tauri-apps/cli": "^2.11.4",
    "@types/node": "^22.10.0",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "@vitejs/plugin-react": "^4.7.0",
    "playwright": "^1.62.1",
    "tsx": "^4.19.0",
    "typescript": "^5.7.3",
    "vite": "^5.4.21",
    "vitest": "^2.1.8"
  }
}
